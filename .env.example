# ---------- Básico
# SECRET_KEY: gere uma chave própria (obrigatória em qualquer servidor) com:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# A chave de exemplo abaixo só funciona com DEBUG=True e ALLOWED_HOSTS local (desenvolvimento na sua máquina).
SECRET_KEY=replace-with-a-long-random-secret
# Desenvolvimento: mude para True. Produção: deixe False.
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
# Endereços completos usados para acessar o site por HTTPS ou por outro host (separados por vírgula)
# Ex.: CSRF_TRUSTED_ORIGINS=https://eventos.exemplo.br
CSRF_TRUSTED_ORIGINS=

# ---------- Banco de dados
DB_NAME=arena_events
DB_USER=arena_user
DB_PASSWORD=arena_password
DB_HOST=localhost
DB_PORT=5432
# Recomendado em produção (SEC-03): a aplicação usa o papel DB_USER, sem poder mudar a estrutura nem alterar a
# auditoria; o dono das tabelas (só para migrações e backup) fica abaixo. Ver README, "Banco: dois papéis".
DB_MIGRATE_USER=
DB_MIGRATE_PASSWORD=

# ---------- Produção (só têm efeito com DEBUG=False)
# HTTPS_ENABLED=True por padrão em produção: cookies seguros e redirecionamento para HTTPS.
# Use False apenas para teste em rede local sem certificado.
HTTPS_ENABLED=
# Quantos proxies reversos confiáveis ficam na frente da aplicação (nginx, Caddy...). 0 = nenhum.
NUM_PROXIES=0
# HSTS: comece com 3600 e aumente para 31536000 quando o HTTPS estiver estável.
SECURE_HSTS_SECONDS=0
# True faz o Django servir as imagens enviadas (/media/) quando não há proxy para isso.
SERVE_MEDIA=False
LOG_LEVEL=INFO
# Verificação em duas etapas de administradores e organizadores. Em produção já é obrigatória;
# False deixa opcional. Duração máxima da sessão dessas contas, em horas.
MFA_REQUIRED=
PRIVILEGED_SESSION_HOURS=8
# Content-Security-Policy: enforce (padrão, bloqueia), report (só registra no log) ou off.
CSP_MODE=enforce
# Endereço do painel administrativo do Django (padrão admin/). Ex.: gestao-arena/
ADMIN_URL=
# Banco em outro servidor: require ou verify-full
DB_SSLMODE=
# Pasta para a exportação diária da auditoria (ver README). Ex. no Docker: /app/private_media/auditoria-exportada
AUDIT_EXPORT_DIR=
# Quem recebe por e-mail o último hash de cada exportação (padrão: o e-mail de alertas de erro).
AUDIT_EXPORT_EMAIL=
# Minutos depois do login em que ações sensíveis (revogar certificado, configurar e-mail) dispensam a senha.
REAUTH_MINUTES=15
# Backup criptografado com age: chave PÚBLICA aqui (ou caminho de arquivo com chaves públicas).
# A chave privada (BACKUP_AGE_IDENTITY) só é usada na restauração e não deve ficar neste servidor.
BACKUP_AGE_RECIPIENT=

# ---------- Endereço público
# Usado nos links dos e-mails (inclusive os lembretes agendados) e no QR de validação do certificado.
# Nome da instituição, cidade, logo e assinatura dos certificados ficam na própria plataforma,
# no menu "Configurações" (visível para administradores).
SITE_URL=http://127.0.0.1:8000

# ---------- E-mail
# Fila de e-mails: thread (padrão) envia em segundo plano no próprio servidor; off deixa só para o comando
# "python manage.py process_outbox" (serviço worker do Docker). No Docker o web já usa off (docker-compose.yml).
# Veja "Fila de e-mails" no README.
OUTBOX_MODE=thread
# Dias que destinatário e conteúdo dos e-mails enviados ficam guardados (0 = para sempre).
OUTBOX_RETENTION_DAYS=30
# "Tentar de novo" em Configurações > E-mail só reenvia as falhas destes últimos dias.
OUTBOX_RETRY_DAYS=3
# O servidor SMTP/relay é configurado dentro da plataforma: Configurações > E-mail.
# A senha do SMTP fica criptografada no banco com uma chave derivada da SECRET_KEY;
# se a SECRET_KEY mudar, cadastre a senha do SMTP de novo.
