# ---------- Básico
# Em produção (DEBUG=False) a SECRET_KEY é obrigatória. Gere com:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Endereços completos usados para acessar o site por HTTPS ou por outro host (separados por vírgula)
# Ex.: CSRF_TRUSTED_ORIGINS=https://eventos.exemplo.br
CSRF_TRUSTED_ORIGINS=

# ---------- Banco de dados
DB_NAME=arena_events
DB_USER=arena_user
DB_PASSWORD=arena_password
DB_HOST=localhost
DB_PORT=5432

# ---------- Produção (só têm efeito com DEBUG=False)
# HTTPS_ENABLED=True por padrão em produção: cookies seguros e redirecionamento para HTTPS.
# Use False apenas para teste em rede local sem certificado.
HTTPS_ENABLED=
# Quantos proxies reversos confiáveis ficam na frente da aplicação (nginx, Caddy...). 0 = nenhum.
NUM_PROXIES=0
# HSTS: comece com 3600 e aumente para 31536000 quando o HTTPS estiver estável.
SECURE_HSTS_SECONDS=0
# True faz o Django servir as imagens enviadas (/media/) quando não há proxy para isso.
SERVE_MEDIA=False
LOG_LEVEL=INFO

# ---------- Endereço público
# Usado nos links dos e-mails (inclusive os lembretes agendados) e no QR de validação do certificado.
# Nome da instituição, cidade, logo e assinatura dos certificados ficam na própria plataforma,
# no menu "Configurações" (visível para administradores).
SITE_URL=http://127.0.0.1:8000

# ---------- E-mail
# O servidor SMTP/relay é configurado dentro da plataforma: Configurações > E-mail.
# A senha do SMTP fica criptografada no banco com uma chave derivada da SECRET_KEY;
# se a SECRET_KEY mudar, cadastre a senha do SMTP de novo.
